{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (J-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/stm32f0303f4_digital_encoder.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "STM32F030F4",
            "interface": "swd",
            "serialNumber": "",
            "preLaunchTask": "Build Debug",
            "resetAfterLoad": true,
            "loadFiles": [
                "${workspaceFolder}/build/Debug/stm32f0303f4_digital_encoder.elf"
            ],
            "postRestartCommands": [
                "monitor reset",
                "monitor halt"
            ]
        },
        {
            "name": "Attach (J-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/stm32f0303f4_digital_encoder.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "STM32F030F4",
            "interface": "swd",
            "serialNumber": ""
        }
    ]
}
